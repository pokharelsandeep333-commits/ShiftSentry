# Public browser configuration
# Supabase Dashboard -> Connect -> API Keys -> Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_key

# Server-only configuration
# Supabase Dashboard -> Connect -> API Keys -> Secret key (sb_secret_...)
SUPABASE_SECRET_KEY=sb_secret_replace_with_your_key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres?schema=public
ADMIN_EMAIL_ALLOWLIST=you@example.com

# In Supabase Auth, add this local redirect URL:
# http://localhost:3000/auth/callback
