generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN

  @@map("app_role")
}

model Profile {
  id                       String       @id @db.Uuid
  email                    String       @unique
  displayName              String?      @map("display_name")
  role                     Role         @default(USER)
  timeZone                 String       @default("America/Chicago") @map("time_zone")
  weekStartsOn             Int          @default(0) @map("week_starts_on")
  globalWeeklyLimitMinutes Int?         @map("global_weekly_limit_minutes")
  disabledAt               DateTime?    @map("disabled_at") @db.Timestamptz(6)
  deletionPendingAt        DateTime?    @map("deletion_pending_at") @db.Timestamptz(6)
  createdAt                DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  jobs                     Job[]
  shifts                   Shift[]
  auditEvents              AuditEvent[] @relation("AuditActor")
  googleCalendarConnection GoogleCalendarConnection?
  weekNotes                WeekNote[]
  legalAcceptances         LegalAcceptance[]
  supportNotes             AdminUserNote[] @relation("NoteSubject")
  supportNotesWritten      AdminUserNote[] @relation("NoteAuthor")
  announcementsPosted      SiteAnnouncement[] @relation("AnnouncementAuthor")
  announcementsCleared     SiteAnnouncement[] @relation("AnnouncementClearer")

  @@map("profiles")
}

model LegalVersion {
  version     String @id
  minimumAge  Int @map("minimum_age")
  documents   Json
  publishedAt DateTime @default(now()) @map("published_at") @db.Timestamptz(6)
  acceptances LegalAcceptance[]

  @@map("legal_versions")
}

model LegalAcceptance {
  userId     String @map("user_id") @db.Uuid
  version    String
  acceptedAt DateTime @default(now()) @map("accepted_at") @db.Timestamptz(6)
  profile    Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  document   LegalVersion @relation(fields: [version], references: [version])

  @@id([userId, version])
  @@map("legal_acceptances")
}

model Job {
  id                       String   @id @default(uuid()) @db.Uuid
  userId                   String   @map("user_id") @db.Uuid
  name                     String
  color                    String   @default("#9486ff")
  weeklyLimitMinutes       Int?     @map("weekly_limit_minutes")
  hourlyRateCents          Int      @default(0) @map("hourly_rate_cents")
  taxRateBasisPoints       Int      @default(0) @map("tax_rate_basis_points")
  archivedAt               DateTime? @map("archived_at") @db.Timestamptz(6)
  googleKeyword            String?  @map("google_keyword")
  googleCalendarId         String?  @map("google_calendar_id")
  googleSync               Boolean  @default(false) @map("google_sync")
  googleSyncIgnored        String[] @default([]) @map("google_sync_ignored")
  paySchedule              String   @default("none") @map("pay_schedule")
  payIntervalWeeks         Int?     @map("pay_interval_weeks") @db.SmallInt
  payAnchorDate            DateTime? @map("pay_anchor_date") @db.Date
  payMonthDay              Int?     @map("pay_month_day") @db.SmallInt
  paydayOffsetDays         Int?     @map("payday_offset_days") @db.SmallInt
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                     Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  shifts                   Shift[]
  deductions               JobDeduction[]

  @@index([userId, archivedAt])
  @@map("jobs")
}

model Shift {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  jobId     String   @map("job_id") @db.Uuid
  startsAt  DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt    DateTime @map("ends_at") @db.Timestamptz(6)
  notes     String?
  hourlyRateCents        Int      @default(0) @map("hourly_rate_cents")
  taxRateBasisPoints     Int      @default(0) @map("tax_rate_basis_points")
  deductionsSnapshot     Json     @default("[]") @map("deductions_snapshot")
  grossCents             Int      @default(0) @map("gross_cents")
  taxCents               Int      @default(0) @map("tax_cents")
  deductionCents         Int      @default(0) @map("deduction_cents")
  netCents               Int      @default(0) @map("net_cents")
  googleCalendarId       String?  @map("google_calendar_id")
  googleEventId          String?  @map("google_event_id")
  googleAdopted          Boolean  @default(false) @map("google_adopted")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@unique([userId, jobId, startsAt, endsAt], map: "shifts_no_duplicate_span")
  @@index([userId, startsAt])
  @@index([jobId, startsAt])
  @@map("shifts")
}

model WeekNote {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  weekStart DateTime @map("week_start") @db.Date
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  profile   Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart], map: "week_notes_one_per_week")
  @@map("week_notes")
}

model JobDeduction {
  id              String   @id @default(uuid()) @db.Uuid
  jobId           String   @map("job_id") @db.Uuid
  name            String
  rateBasisPoints Int      @map("rate_basis_points")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  job             Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("job_deductions")
}

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  targetUserId String? @map("target_user_id") @db.Uuid
  action      String
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor       Profile? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([targetUserId, createdAt])
  @@map("audit_events")
}

/// Admin-only support notes (20261016120000_admin_support_tools.sql). No API
/// role can reach the table; included in the subject's export without the author.
model AdminUserNote {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  authorId  String?  @map("author_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  subject   Profile  @relation("NoteSubject", fields: [userId], references: [id], onDelete: Cascade)
  author    Profile? @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)], map: "admin_user_notes_user_created")
  @@index([authorId], map: "admin_user_notes_author")
  @@map("admin_user_notes")
}

/// Admin-posted banner notices (20261016140000_site_announcements.sql). At most
/// one live (clearedAt null); signed-in users read only the live one's text.
model SiteAnnouncement {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  message   String
  tone      String    @default("info")
  createdBy String?   @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  clearedAt DateTime? @map("cleared_at") @db.Timestamptz(6)
  clearedBy String?   @map("cleared_by") @db.Uuid
  author    Profile?  @relation("AnnouncementAuthor", fields: [createdBy], references: [id], onDelete: SetNull)
  clearer   Profile?  @relation("AnnouncementClearer", fields: [clearedBy], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)], map: "site_announcements_created")
  @@index([createdBy], map: "site_announcements_created_by")
  @@index([clearedBy], map: "site_announcements_cleared_by")
  @@map("site_announcements")
}

model GoogleCalendarConnection {
  userId                 String    @id @map("user_id") @db.Uuid
  googleEmail            String    @map("google_email")
  refreshTokenCiphertext String    @map("refresh_token_ciphertext")
  accessTokenCiphertext  String?   @map("access_token_ciphertext")
  accessTokenExpiresAt   DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  scopes                 String[]
  selectedCalendarIds    String[]  @default(["primary"]) @map("selected_calendar_ids")
  status                 String    @default("active")
  syncIssues             Json      @default("[]") @map("sync_issues")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  profile                Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("google_calendar_connections")
}
